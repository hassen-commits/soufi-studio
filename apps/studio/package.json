{
  "name": "@soufi/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -o -e ../../.env -- tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate:corpus": "dotenv -o -e ../../.env.migrate -- tsx src/scripts/migrate-corpus.ts",
    "clean:ghazali": "dotenv -o -e ../../.env -- tsx src/scripts/clean-ghazali.ts",
    "ingest:pdf": "dotenv -o -e ../../.env -- tsx src/scripts/ingest-pdf.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@hono/node-server": "^1.13.7",
    "@soufi/content": "workspace:*",
    "@supabase/supabase-js": "^2.46.1",
    "hono": "^4.6.14",
    "node-cron": "^3.0.3",
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.4",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
